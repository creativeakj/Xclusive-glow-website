# ── Shopify Storefront API (catalog, cart) ──────────────────────────────────
# Store's *.myshopify.com domain (not the custom/branded domain).
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Storefront API access token: Shopify Admin > Sales channels > Headless
# (add the free "Headless" channel if not already added) > your storefront >
# Storefront API > Manage > "Private access token" (NOT "Public access
# token" — this app calls Shopify server-side only).
SHOPIFY_STOREFRONT_API_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-07

# ── Shopify Customer Account API (authenticated customer login) ────────────
# Same Headless channel storefront > Customer Account API > Manage.
# Numeric shop ID — not shown on that page; get it via the Admin API
# `shop { id }` query (GraphiQL app) or your Shopify Admin URL.
SHOPIFY_SHOP_ID=
# Client ID shown under "Customer Account API credentials".
SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_API_VERSION=2026-07
# Must be added to "Callback URI(s)" under Application setup on that page.
SHOPIFY_CUSTOMER_ACCOUNT_REDIRECT_URI=http://localhost:3000/account/callback
# The base of the Authorization/Token/Logout endpoints shown under
# "Application endpoints" on that page, e.g. https://account.your-store.com
# (no trailing slash, no /authentication suffix — the code adds that).
SHOPIFY_CUSTOMER_ACCOUNT_AUTH_BASE_URL=

# ── Session security ─────────────────────────────────────────────────────
# Random 32+ byte secret used to encrypt the customer session cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# ── Site ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
